# Global properties
separator=true
separator_block_width=15

[weather]
command=curl -Ss 'https://wttr.in?format=j1' | jq -r '[.weather[0].hourly[].chanceofrain | tonumber] | max | "Rain: \(.)%"'
interval=3600
color=#A4C2F4

[public-ip]
command=wget -qO - icanhazip.com
interval=once
color=#D9D2E9

[ip]
command=hostname -i | awk '{ print $1 }'
interval=once
color=#91E78B

[ram]
command=free -h | awk '/^Mem:/ {print "RAM:", $3 "/" $2}'
interval=10
color=#F9CB9C

[cpu]
command=top -bn1 | awk -F'[, ]+' '/Cpu\(s\)/ {print "CPU:", 100-$8}'
interval=5
color=#E06666

[storage]
command=df -h /home | awk 'NR==2 {print "Disk:", $3 "/" $2}'
interval=30
color=#FFD966

[battery]
command=acpi -b | awk -F', ' '{print "🔋" $2}'
interval=10
color=#76A5AF

[time]
command=date '+%d %b %H:%M'
interval=1
color=#FFFFFF
